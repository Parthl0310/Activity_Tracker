# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/activity_tracker?retryWrites=true&w=majority

# JWT Secrets (Random string 32+ characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Frontend URL (e.g. https://your-frontend.vercel.app or http://localhost:5173)
FRONTEND_URL=https://your-frontend.vercel.app

# Redis / Upstash Connection URL
REDIS_URL=rediss://default:your_upstash_redis_token@your-redis.upstash.io:6379

# AI & Vector Store
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=activity-tracker

# Node Environment
NODE_ENV=production
